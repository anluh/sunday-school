rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null && request.auth.token.email == 'teacher@sunday-school.local';
    }

    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    function isGoogleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{userId} {
      allow read: if isTeacher() || (request.auth != null && request.auth.uid == userId);
      allow create: if isGoogleUser() && request.auth.uid == userId &&
        request.resource.data.uid == userId && request.resource.data.totalScore == 0 &&
        request.resource.data.reviewedSubmissionsCount == 0 && request.resource.data.lastReviewedAt == null;
      allow update: if isTeacher() || (isGoogleUser() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']));
      allow delete: if isTeacher();
    }

    match /submissions/{submissionId} {
      allow create: if isGoogleUser() &&
        request.resource.data.keys().hasOnly([
          'sessionId', 'childName', 'childNameNormalized', 'childUid', 'childEmail', 'childPhotoURL', 'childNameIdPart',
          'answers', 'scores', 'totalScore', 'reviewed', 'submittedAt'
        ]) &&
        request.resource.data.childName is string &&
        request.resource.data.childName.size() >= 2 &&
        request.resource.data.childNameNormalized is string &&
        request.resource.data.childUid == request.auth.uid &&
        request.resource.data.childEmail == request.auth.token.email &&
        request.resource.data.totalScore == 0 &&
        request.resource.data.reviewed == false &&
        request.resource.data.scores == {};

      allow get: if true;
      allow list, update, delete: if isTeacher();
    }

    match /childReceipts/{receiptId} {
      allow get, create: if true;
      allow list: if false;
      allow update, delete: if isTeacher();
    }
  }
}
